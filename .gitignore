# Claude scratch space — skill-generated specs/plans/artifacts.
# Final committed docs go under docs/specs/ or docs/architecture/.
docs/superpowers/

# Git worktrees created by superpowers workflows.
.worktrees/

# Firebase config — place real files locally, never commit them.
androidApp/google-services.json
iosApp/iosApp/GoogleService-Info.plist

# Firebase Admin SDK / GCP service-account keys — secrets, never commit.
# (Used by functions/scripts/seed-catalog.ts via GOOGLE_APPLICATION_CREDENTIALS.)
*-firebase-adminsdk-*.json
*-sa.json
service-account*.json

# Xcode build output written outside the normal DerivedData path.
iosApp/build-device/
iosApp/build-cli/

# Claude Code local state (settings, worktrees, transcripts).
.claude/

# Fastlane generated artifacts (reports, fetched metadata, ephemeral output).
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
fastlane/Preview.html
**/*.p8
**/*.jks
**/upload.keystore
build/ios/

# Ruby / Bundler local install path.
vendor/bundle/
.bundle/
