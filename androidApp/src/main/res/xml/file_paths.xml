<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider path config (single provider, two authorities — see AndroidManifest.xml):
  - "share_cards/": shareable story-card PNG (StoryShareLauncherAndroid); the generated
    content:// URI is read by Instagram / the system share sheet with a per-share
    read-permission grant. (Shareable story cards, spec §6.1.)
  - "photopicker/": native camera capture temp files (rememberPhotoPicker → TakePicture);
    each file is deleted as soon as its bytes are read.
  No other directory is exposed.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="share_cards" path="share_cards/"/>
    <cache-path name="photopicker" path="photopicker/"/>
</paths>
