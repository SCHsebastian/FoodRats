<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider path config for the shareable story-card PNG (StoryShareLauncherAndroid).
  Exposes the app's internal cache dir (where the card is written under "share_cards/") so the
  generated content:// URI can be read by Instagram / the system share sheet with a per-share
  read-permission grant. No other directory is exposed. (Shareable story cards, spec §6.1.)
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="share_cards" path="share_cards/"/>
</paths>
