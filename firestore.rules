rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Identity / account profiles
    match /accounts/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid ||
                      // any crew you're in can read your profile
                      exists(/databases/$(database)/documents/crews/$(uid)) == false);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /devices/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Crew root
    match /crews/{crewId} {
      allow read:   if request.auth != null && request.auth.uid in resource.data.memberIds;
      // Update is partitioned into three explicit paths so non-owners can't rename the crew
      // and rogue clients can't rewrite ownerId / createdAt / code:
      //   (1) owner-only rename of `name`
      //   (2) self-rename inside the `members` map (any current member; client enforces self-only)
      //   (3) membership flux — join/leave touches `memberIds` + `members` together, size <= 8
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && (
                      (resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
                          && request.resource.data.memberIds.size() <= 8)
                    );
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;
      // Delete is allowed when either the last member leaves OR the owner explicitly deletes.
      allow delete: if request.auth != null
                    && (
                      (request.auth.uid in resource.data.memberIds && resource.data.memberIds.size() == 1)
                      || resource.data.ownerId == request.auth.uid
                    );

      // Meals are scoped under crews. Up to 3 per author per day — one per slot.
      // Deterministic doc ID enforces same-day-per-slot uniqueness without composite indexes.
      match /meals/{mealId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                      && request.resource.data.slot in ["breakfast", "lunch", "dinner"]
                      && mealId == crewId + "_" + request.auth.uid + "_" + request.resource.data.dayKey + "_" + request.resource.data.slot
                      && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId));
        // No update or delete path — meals are immutable once published.

        match /ratings/{raterUid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          allow create: if request.auth != null
                        && raterUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.auth.uid != get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.authorId
                        && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)/ratings/$(raterUid))
                        && request.resource.data.score is int
                        && request.resource.data.score >= 1
                        && request.resource.data.score <= 5
                        && request.resource.data.ratedAtEpochMs is int
                        && request.time.toMillis() - get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.publishedAtEpochMs < 172800000;
        }
      }
    }

    // Invite codes — doc ID is the code; existence = uniqueness
    match /crewCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/crewCodes/$(code));
      allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/crews/$(resource.data.crewId)).data.memberIds;
    }
  }
}
