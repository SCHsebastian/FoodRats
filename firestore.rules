rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Identity / account profiles — PUBLIC display fields only (handle,
    // displayName, avatarUrl). Readable by any authenticated user: a member must
    // be able to render crew-mates' names + avatars in the feed, comments and the
    // member list, and identity is resolved by reading the top-level account doc
    // (AccountReadPort) rather than a per-crew denormalized copy. This mirrors the
    // soft-token posture already in effect for /crews and /crewCodes (knowing the
    // random id is the capability to read it).
    //
    // PII (email) is deliberately NOT stored on this doc — it lives only in
    // Firebase Auth and, if ever surfaced again, under the owner-only /private
    // subcollection below. (Was previously gated by a logically-inverted
    // `exists(/crews/$(uid)) == false` predicate that evaluated true for nearly
    // every read — a meaningless guard. See docs/reviews/2026-06-13-aaa-architecture-review.md §5.13.)
    //
    // Hardening backlog: scope reads to crew-mates via a `crewIds` reverse index
    // + `hasAny()` (requires maintaining the index atomically on join/leave).
    match /accounts/{uid} {
      allow read:  if request.auth != null;
      // Create: owner initialises their own profile doc.  `badgeId` must be absent
      // (the @EncodeDefault(NEVER) annotation on AccountDto guarantees the app never
      // sends it, but the rule provides an independent security layer).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !('badgeId' in request.resource.data);
      // Update: owner may update any field EXCEPT `badgeId`.  `badgeId` is server-only —
      // assigned exclusively by the onMealCreated Cloud Function via the Admin SDK (which
      // bypasses rules).  Reject any update that attempts to add or change `badgeId`.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['badgeId']);
      // Delete: handled server-side only (deleteAccount Cloud Function + Admin SDK).
      allow delete: if false;

      // Owner-only private data (PII, consent, anything that must never be
      // crew-visible). Reads are denied to everyone but the owner.
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /devices/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Unlocked-achievement timestamps (badges design §16). One doc per unlocked
      // achievement (`accounts/{uid}/achievements/{achievementId}` = `{ unlockedAtEpochMs }`);
      // absence = locked. Owner-only on BOTH read and write — stricter than the
      // accounts/{uid} doc itself: achievements are private to the owner (like
      // /private and /devices), not crew-visible. Earning is client-derived, so the
      // owner legitimately writes these.
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Server-only nudge dedupe markers (`nudges/{dayKey}`) written by the
      // `streakNudge` Cloud Function via the Admin SDK (which bypasses rules).
      // Never read or written by clients — deny all client access explicitly so a
      // future broad rule can't accidentally expose this internal bookkeeping.
      match /nudges/{dayKey} {
        allow read, write: if false;
      }

      // Server-only badge bookkeeping (U8). The lifetime publish counter
      // (`badgeProgress/counter`) and the per-publish dedup markers
      // (`publishedMealKeys/{canonicalKey}`) are written ONLY by the onMealCreated Cloud
      // Function via the Admin SDK (which bypasses rules). Deny all client access so the
      // raw count is neither world-readable (no leaderboard arms race) nor client-forgeable
      // (a client cannot inflate its own count to fast-track a higher badge tier).
      match /badgeProgress/{doc} {
        allow read, write: if false;
      }
      match /publishedMealKeys/{canonicalKey} {
        allow read, write: if false;
      }

      // Block list (UGC compliance §5). Owner-private on read AND write — mirrors
      // /devices and /achievements above. The doc id IS the blocked account id;
      // only the owner can see or modify whom they've blocked. Used purely as a
      // client-side read filter (no server fan-out).
      match /blocks/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Crew root
    match /crews/{crewId} {
      // True when a membership write (join / leave / remove-member) leaves EVERY
      // non-membership field untouched. The client commits these as a full-document
      // `set(crewRef, crew.copy(...))` — GitLive `.set(dto)` re-serializes the WHOLE
      // CrewDto with encodeDefaults=true, so a crew created before a field existed
      // (scoreStyle, bannerPath, …) receives that field as a newly-ADDED key. A naive
      // `diff().affectedKeys().hasOnly(['memberIds','members'])` counts those re-stated
      // defaults as changes and rejected EVERY join/leave/remove on an older crew (the
      // reported "no one can join" bug). Comparing each field to its effective
      // (default-resolved) prior value with get(k, default) treats "absent" and
      // "re-stated default" as equal, while still rejecting a real change — so a joiner
      // can ONLY append themselves and can never seize ownership, rotate the invite code,
      // backdate the crew, rename it, or flip any owner-only policy. Defaults mirror
      // CrewDto exactly: blindVoting=false, scoreStyle='stars', every other optional null.
      function onlyMembershipUnchanged() {
        return request.resource.data.get('id', null) == resource.data.get('id', null)
          && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
          && request.resource.data.get('code', null) == resource.data.get('code', null)
          && request.resource.data.get('createdAtEpochMs', null) == resource.data.get('createdAtEpochMs', null)
          && request.resource.data.get('name', null) == resource.data.get('name', null)
          && request.resource.data.get('blindVoting', false) == resource.data.get('blindVoting', false)
          && request.resource.data.get('tagline', null) == resource.data.get('tagline', null)
          && request.resource.data.get('welcomeMessage', null) == resource.data.get('welcomeMessage', null)
          && request.resource.data.get('weeklyChallenge', null) == resource.data.get('weeklyChallenge', null)
          && request.resource.data.get('weeklyChallengeSetAtMillis', null) == resource.data.get('weeklyChallengeSetAtMillis', null)
          && request.resource.data.get('scoreStyle', 'stars') == resource.data.get('scoreStyle', 'stars')
          && request.resource.data.get('bannerPath', null) == resource.data.get('bannerPath', null)
          && request.resource.data.get('bannerFocalY', null) == resource.data.get('bannerFocalY', null);
      }
      // Read is open to any authenticated user. `crewId` is a random UUID, so it
      // functions as a soft access token — you need it to read the doc, and a
      // joining user must be able to read the doc inside the joinByCode transaction
      // before writing themselves into memberIds. Consistent with /crewCodes/ which
      // is already readable by any authenticated user.
      allow read:   if request.auth != null;
      // Update is partitioned into explicit branches so non-owners can't rename
      // the crew and rogue clients can't rewrite ownerId / createdAt / code:
      //   (1) owner renames `name`
      //   (2) any current member renames themselves inside the `members` map
      //   (3) join — non-member adds self (auth.uid moves from absent to present in memberIds)
      //   (4) leave — existing member removes self (and only self) from memberIds + members
      //   (5) owner toggles the `blindVoting` policy flag (owner-only; no other field touched)
      //   (6) remove-member — owner removes another member (never self) from memberIds + members
      //   (7) owner sets/clears the `tagline` field (owner-only; no other field touched)
      allow update: if request.auth != null
                    && (
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blindVoting'])
                       && request.resource.data.blindVoting is bool)
                      ||
                      // (7) owner sets or clears the tagline (null = cleared; string = up to 120 chars).
                      // `in` check is on resource.data (existing doc) so the owner must still be a member.
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagline'])
                       && (request.resource.data.tagline == null || request.resource.data.tagline is string))
                      ||
                      // (8) owner sets or clears the welcomeMessage (null = cleared; string = up to 200 chars).
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['welcomeMessage'])
                       && (request.resource.data.welcomeMessage == null || request.resource.data.welcomeMessage is string))
                      ||
                      // (9) owner sets or clears the weeklyChallenge + weeklyChallengeSetAtMillis (both
                      // must be written together — either both null (clear) or string + int (set)).
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weeklyChallenge', 'weeklyChallengeSetAtMillis'])
                       && (request.resource.data.weeklyChallenge == null || request.resource.data.weeklyChallenge is string)
                       && (request.resource.data.weeklyChallengeSetAtMillis == null || request.resource.data.weeklyChallengeSetAtMillis is int))
                      ||
                      // (10) owner sets the scoreStyle vocabulary (C8). Only the three valid
                      // string values are accepted; any unknown value or type is rejected.
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreStyle'])
                       && request.resource.data.scoreStyle in ['stars', 'emoji', 'numeric'])
                      ||
                      // (11) owner sets or clears the bannerPath (C9). null = removed; string = Storage
                      // object path for the crew banner image. The Storage write is enforced by
                      // storage.rules; this rule only locks the Firestore field pointer.
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bannerPath'])
                       && (request.resource.data.bannerPath == null || request.resource.data.bannerPath is string))
                      ||
                      // (12) owner sets the banner vertical focal point (C9): a number in 0..1 that
                      // tells the fixed-height feed crop which slice of the image to show.
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bannerFocalY'])
                       && request.resource.data.bannerFocalY is number
                       && request.resource.data.bannerFocalY >= 0
                       && request.resource.data.bannerFocalY <= 1)
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
                      ||
                      // (3) join — a non-member appends ONLY themselves. Written as a full-document
                      // set() by the client, so we pin every non-membership field (onlyMembershipUnchanged)
                      // and require the prior member set to survive intact (hasAll) with the count up by one.
                      (!(request.auth.uid in resource.data.memberIds)
                       && request.auth.uid in request.resource.data.memberIds
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                       && request.resource.data.memberIds.size() <= 8
                       && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                       && onlyMembershipUnchanged())
                      ||
                      // (4) leave — an existing member removes ONLY themselves. Full-document set();
                      // every surviving member was already present (hasAll on the OLD set) and the
                      // count drops by exactly one, so no other member can be evicted in the same write.
                      (request.auth.uid in resource.data.memberIds
                       && !(request.auth.uid in request.resource.data.memberIds)
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                       && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                       && onlyMembershipUnchanged())
                      ||
                      // (6) owner removes ANOTHER member: owner stays a member, the removed uid is
                      // dropped from both memberIds + members, and the set shrinks by exactly one.
                      // The owner can't remove self through this branch (they remain in the new
                      // memberIds). Full-document set(): every surviving member was already present
                      // (hasAll on the OLD set) and onlyMembershipUnchanged pins ownerId/code/name/etc.
                      (resource.data.ownerId == request.auth.uid
                       && request.auth.uid in request.resource.data.memberIds
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
                       && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                       && onlyMembershipUnchanged())
                    );
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;
      // Delete is allowed when either the last member leaves OR the owner explicitly deletes.
      allow delete: if request.auth != null
                    && (
                      (request.auth.uid in resource.data.memberIds && resource.data.memberIds.size() == 1)
                      || resource.data.ownerId == request.auth.uid
                    );

      // Meals are scoped under crews. The per-author per-day cap (10) is enforced CLIENT-SIDE —
      // Firestore rules can't count documents. The doc id is `crewId_uid_dayKey_token` where token
      // is a stable per-post hash (idempotent retries + reconstructible per-crew delete). The rule
      // pins ownership, the optional slot vocabulary, and the id shape via split('_') (none of the
      // four parts contains '_': auto-ids/uids are alphanumeric, dayKey is YYYY-MM-DD, token is hex).
      match /meals/{mealId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId
                      && request.resource.data.crewId == crewId
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                      && (request.resource.data.slot == ""
                          || request.resource.data.slot in ["breakfast", "brunch", "lunch", "snack", "merienda", "dinner"])
                      && request.resource.data.id == mealId
                      && mealId.split("_").size() == 4
                      && mealId.split("_")[0] == crewId
                      && mealId.split("_")[1] == request.auth.uid
                      && mealId.split("_")[2] == request.resource.data.dayKey
                      && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId))
                      // Whitelist the client-writable fields at publish. The server-owned fields
                      // `thumbHash` / `thumbnailPath` are written later by the image pipeline via
                      // the Admin SDK (which bypasses rules); a client must not be able to forge the
                      // blur placeholder or spoof a thumbnail URL at create. They are LISTED here —
                      // because GitLive's `.set(dto)` serializes with `encodeDefaults = true`, so it
                      // sends EVERY MealDto field, including these two as `null` — but pinned to
                      // `null` by the two clauses below so a client can only ever send them empty.
                      // `keys()` (not `diff().affectedKeys()`) because every field is new on create;
                      // hasOnly permits any of these to be absent (defaulted). Mirrors MealDto.
                      && request.resource.data.keys().hasOnly([
                        'id', 'authorId', 'authorName', 'crewId', 'dayKey', 'slot', 'platePath',
                        'dishName', 'description', 'latitude', 'longitude', 'publishedAtEpochMs',
                        'ratings', 'ratingSum', 'voterCount', 'ingredients', 'classifierVersion',
                        'cuisine', 'kind', 'thumbHash', 'thumbnailPath'
                      ])
                      // Server-owned: a client may only send these as null (or omit them).
                      && (!('thumbHash' in request.resource.data) || request.resource.data.thumbHash == null)
                      && (!('thumbnailPath' in request.resource.data) || request.resource.data.thumbnailPath == null)
                      // A meal MUST be created with zero rating aggregates. Without this
                      // the author could publish with ratingSum:9999 / voterCount:9 and win
                      // the server-attested weekly Best Cook / Best Meal digest. The vote
                      // path (update rule below) is the only way these may grow, recomputed
                      // from the `ratings` map. Tolerate absent fields (kotlinx-serialization
                      // may omit defaults on the create write).
                      && (!('ratingSum' in request.resource.data) || request.resource.data.ratingSum == 0)
                      && (!('voterCount' in request.resource.data) || request.resource.data.voterCount == 0)
                      && (!('ratings' in request.resource.data) || request.resource.data.ratings.size() == 0)
                      // No back/forward-dating into a different digest window.
                      && (!('publishedAtEpochMs' in request.resource.data)
                          || request.resource.data.publishedAtEpochMs <= request.time.toMillis() + 300000);
        // Rating-write update: a voter (not the author) may add their own entry to the
        // `ratings` map, OR change it exactly ONCE. The diff is limited to the three
        // denormalized rating fields, the voter can only touch their own key in the map,
        // and the cached sum/count must equal the recomputed values from the new map.
        // A voter gets one change: a first vote writes `edited:false`, the single allowed
        // change overwrites it with `edited:true`, and any further attempt (entry already
        // `edited`) is rejected here. `.get('edited', false)` tolerates pre-feature entries.
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                      && request.auth.uid != resource.data.authorId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['ratings', 'ratingSum', 'voterCount'])
                      && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys()
                           .hasOnly([request.auth.uid])
                      && request.resource.data.ratings[request.auth.uid].score is int
                      && request.resource.data.ratings[request.auth.uid].score >= 1
                      && request.resource.data.ratings[request.auth.uid].score <= 5
                      && request.resource.data.voterCount == request.resource.data.ratings.size()
                      && request.time.toMillis() - resource.data.publishedAtEpochMs < 172800000
                      && (
                        // First vote: no prior entry; the new entry is not-yet-edited; the sum
                        // grows by exactly the new score (a client can't inflate the aggregate).
                        (
                          !(request.auth.uid in resource.data.ratings)
                          && request.resource.data.ratings[request.auth.uid].get('edited', false) == false
                          && request.resource.data.ratingSum == resource.data.ratingSum + request.resource.data.ratings[request.auth.uid].score
                        )
                        ||
                        // The single allowed change: prior entry exists and was NOT yet edited; the
                        // new entry is marked edited; the sum adjusts by the score delta (old → new).
                        (
                          request.auth.uid in resource.data.ratings
                          && resource.data.ratings[request.auth.uid].get('edited', false) == false
                          && request.resource.data.ratings[request.auth.uid].get('edited', false) == true
                          && request.resource.data.ratingSum == resource.data.ratingSum - resource.data.ratings[request.auth.uid].score + request.resource.data.ratings[request.auth.uid].score
                        )
                      );

        // Delete: the meal's author OR the crew owner may delete it. Author = self-service,
        // owner = moderation. Orphaned subcollections (comments, deprecated ratings) are
        // swept by the onMealDeleted Cloud Function since Firestore deletes don't cascade.
        allow delete: if request.auth != null
                      && (
                        request.auth.uid == resource.data.authorId
                        || request.auth.uid == get(/databases/$(database)/documents/crews/$(crewId)).data.ownerId
                      );

        // DEPRECATED 2026-05-20 — superseded by the denormalized `ratings` map on the
        // meal document itself. New clients never write to this subcollection. The
        // rule is kept for one release so any stragglers fail visibly rather than
        // silently. Remove in a follow-up cleanup.
        match /ratings/{raterUid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          allow create: if request.auth != null
                        && raterUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.auth.uid != get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.authorId
                        && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)/ratings/$(raterUid))
                        && request.resource.data.score is int
                        && request.resource.data.score >= 1
                        && request.resource.data.score <= 5
                        && request.resource.data.ratedAtEpochMs is int
                        && request.time.toMillis() - get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.publishedAtEpochMs < 172800000;
        }

        match /comments/{commentId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          allow create: if request.auth != null
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.auth.uid == request.resource.data.authorId
                        && request.resource.data.text is string
                        && request.resource.data.text.size() >= 1
                        && request.resource.data.text.size() <= 500
                        && request.resource.data.createdAtEpochMs is int
                        && request.resource.data.createdAtEpochMs <= request.time.toMillis() + 60000
                        && request.resource.data.createdAtEpochMs >= request.time.toMillis() - 60000;

          // Comments are immutable once posted, EXCEPT an idempotent self-replay: when the
          // offline outbox replays a queued comment whose doc was already written (same
          // client-minted id), the `.set()` lands as an update. Allow it ONLY when nothing
          // meaningful changes — same author, same text — so a replay converges instead of
          // being denied, but a comment can never be edited.
          allow update: if request.auth != null
                        && request.auth.uid == resource.data.authorId
                        && request.resource.data.authorId == resource.data.authorId
                        && request.resource.data.text == resource.data.text;

          // Delete: the comment's author OR the crew owner may delete it (self-service
          // + moderation), mirroring the meal delete rule above.
          allow delete: if request.auth != null
                        && (
                          request.auth.uid == resource.data.authorId
                          || request.auth.uid == get(/databases/$(database)/documents/crews/$(crewId)).data.ownerId
                        );
        }

        // Lightweight reactions (roadmap §1.3). One doc per member — the doc ID IS the
        // reactor uid, so a member can only ever touch their own reaction. The toggle
        // (add/remove) is a create-or-delete of `reactions/{uid}`; a re-react deletes,
        // a different kind overwrites via set (hence `update` is allowed for the owner of
        // the doc). Reads are open to any crew member. No push is sent on react.
        match /reactions/{reactorUid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          // Create OR overwrite-set the member's own reaction. `kind` is a stable snake_case
          // discriminator string (the glyph is derived client-side, never stored).
          allow create, update: if request.auth != null
                        && reactorUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.resource.data.reactorId == request.auth.uid
                        && request.resource.data.kind is string
                        && request.resource.data.kind.size() >= 1
                        && request.resource.data.kind.size() <= 40
                        && request.resource.data.reactedAtEpochMs is int
                        && request.resource.data.reactedAtEpochMs <= request.time.toMillis() + 60000
                        && request.resource.data.reactedAtEpochMs >= request.time.toMillis() - 60000;

          // Delete only your own reaction (the toggle-off path). Same crew-membership
          // invariant as read/create/update — a removed member can't mutate crew data.
          allow delete: if request.auth != null
                        && reactorUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        }
      }
    }

    // Ingredient catalog + dish→ingredients map — public, immutable reference data.
    // Read is open (`if true`) by design: the catalog is non-sensitive food vocabulary
    // and may be fetched before auth. Clients never write — both collections are seeded
    // and maintained only via the admin SDK (`functions/scripts/seed-catalog.ts`), which
    // bypasses Security Rules. (meal-AI design §263-264)
    match /ingredients/{slug} {
      allow read:  if true;
      allow write: if false;
    }
    match /dishIngredientMap/{dishSlug} {
      allow read:  if true;
      allow write: if false;
    }

    // Cuisine catalog + dish→cuisine map (cuisine passport) — public, immutable
    // reference data, same contract as the ingredient catalog above. Seeded only
    // via the admin SDK (`functions/scripts/seed-catalog.ts`); clients never write.
    // (feature roadmap §2.2)
    match /cuisines/{slug} {
      allow read:  if true;
      allow write: if false;
    }
    match /dishCuisineMap/{dishSlug} {
      allow read:  if true;
      allow write: if false;
    }

    // Invite codes — doc ID is the code; existence = uniqueness
    match /crewCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/crewCodes/$(code))
                    && (
                      // Crew-creation path: the crew + its first code are written in ONE
                      // transaction, so the crew doc does not exist in committed state yet
                      // and a get() here would return null. The crews/{id} create rule
                      // already enforces founder-only + memberIds.size()==1, so a code whose
                      // crew is being created in the same commit is legitimate. A code minted
                      // for a crewId that never gets created is an inert orphan (joinByCode
                      // resolves the crew doc and 404s). The crewId is a random 20-char
                      // auto-id, so it can't be aimed at someone else's future crew.
                      !exists(/databases/$(database)/documents/crews/$(request.resource.data.crewId))
                      ||
                      // Existing crew: only a current member may mint a new code for it.
                      request.auth.uid in get(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.memberIds
                    );
      allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/crews/$(resource.data.crewId)).data.memberIds;
    }

    // Reports queue (UGC compliance §4). Create-only by the reporter; NEVER
    // client-readable (it's a moderation queue read only by the onReportCreated
    // function + manual review via the Admin SDK, which bypasses rules — mirrors
    // the server-only nudges deny pattern above). The doc id is
    // `${reporterUid}|${targetKey}` so a reporter can report a given target at
    // most once (idempotent create powers the distinct-reporter count and
    // AlreadyReported). The delimiter is `|` (not `_` / `-`): meal ids embed
    // underscores (`crewId_uid_dayKey_slot`) and ids/day-keys may contain `-`, so
    // those joins were AMBIGUOUS — two distinct (reporter, target) pairs could
    // collide on one doc id, or a crafted targetKey could satisfy the id equality
    // for a different target, undermining the one-report-per-reporter-per-target
    // invariant the distinct count relies on. No component (uid / crewId auto-id /
    // dayKey / slot) can contain `|`, so the id is strictly one-to-one with
    // (reporter, target). Reports are immutable from the client; the server flips
    // status via the Admin SDK.
    //
    // Hardening (UGC review F3/F4/F5/F6):
    //  - `keys().hasOnly([...])` whitelist so a client can't smuggle extra fields
    //    (e.g. a forged status, or a bogus crewId/mealId aimed at a DIFFERENT victim).
    //  - The separate `crewId`/`mealId`/`commentId`/`accountId` fields the trigger
    //    deletes by are PINNED to the validated `targetKey` (rules have no split(),
    //    so we reconstruct the key from the fields and require equality). The trigger
    //    can therefore trust those fields — they provably match the key.
    //  - Crew-membership gate AND target-existence gate for meal/comment targets:
    //    only someone who can READ the content may report it (mirrors the meal read
    //    rule), and the named meal/comment must actually exist — so 3 cheap throwaway
    //    accounts outside the crew can't dogpile-nuke content they were never able to
    //    see, and a forged crewId/mealId pointing at nothing is rejected at create.
    //  - Account target: `accountId != reporter` (no self-report) and the account must
    //    exist. Account reports are human-reviewed only — never auto-actioned.
    // Moderation audit trail (UGC hardening §7.1). Written exclusively by the
    // `onReportCreated` Cloud Function via the Admin SDK (which bypasses rules).
    // No client — not even the app owner — may read or write these docs: triage
    // is done via the Firebase console or the Admin SDK in the RUNBOOK. Mirrors
    // the `nudges` server-only pattern above.
    match /moderationActions/{actionId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read:   if false;            // server-only (Admin SDK)
      allow update,
            delete: if false;            // immutable; server actions use Admin SDK
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'reporterId', 'targetType', 'crewId', 'mealId', 'commentId',
                      'accountId', 'targetKey', 'reason', 'status', 'createdAtEpochMs'
                    ])
                    && request.resource.data.status == "open"
                    && request.resource.data.reason in
                         ["spam", "harassment", "hate", "sexual", "violence", "other"]
                    && request.resource.data.createdAtEpochMs is int
                    && request.resource.data.createdAtEpochMs <= request.time.toMillis() + 60000
                    && request.resource.data.createdAtEpochMs >= request.time.toMillis() - 60000
                    && reportId == request.auth.uid + "|" + request.resource.data.targetKey
                    && (
                      // Meal target: crewId + mealId fields must reconstruct targetKey
                      // exactly (so the trigger's delete-by-fields can't be aimed at an
                      // unrelated meal); the reporter must be a member of that crew and
                      // the meal must exist.
                      (request.resource.data.targetType == "meal"
                       && request.resource.data.crewId is string
                       && request.resource.data.mealId is string
                       && request.resource.data.targetKey ==
                            "meal|" + request.resource.data.crewId + "|" + request.resource.data.mealId
                       && request.auth.uid in
                            get(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.memberIds
                       && exists(/databases/$(database)/documents/crews/$(request.resource.data.crewId)/meals/$(request.resource.data.mealId)))
                      ||
                      // Comment target: crewId + mealId + commentId reconstruct targetKey;
                      // the reporter must be a member of that crew and the comment must exist.
                      (request.resource.data.targetType == "comment"
                       && request.resource.data.crewId is string
                       && request.resource.data.mealId is string
                       && request.resource.data.commentId is string
                       && request.resource.data.targetKey ==
                            "comment|" + request.resource.data.crewId + "|" +
                            request.resource.data.mealId + "|" + request.resource.data.commentId
                       && request.auth.uid in
                            get(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.memberIds
                       && exists(/databases/$(database)/documents/crews/$(request.resource.data.crewId)/meals/$(request.resource.data.mealId)/comments/$(request.resource.data.commentId)))
                      ||
                      // Account target: no crew scope (human-reviewed, never auto-actioned);
                      // accountId reconstructs targetKey, may not be the reporter (no
                      // self-report), and the account must exist.
                      (request.resource.data.targetType == "account"
                       && request.resource.data.accountId is string
                       && request.resource.data.accountId != request.auth.uid
                       && request.resource.data.targetKey == "account|" + request.resource.data.accountId
                       && exists(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)))
                    );
    }
  }
}
