rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Identity / account profiles — PUBLIC display fields only (handle,
    // displayName, avatarUrl). Readable by any authenticated user: a member must
    // be able to render crew-mates' names + avatars in the feed, comments and the
    // member list, and identity is resolved by reading the top-level account doc
    // (AccountReadPort) rather than a per-crew denormalized copy. This mirrors the
    // soft-token posture already in effect for /crews and /crewCodes (knowing the
    // random id is the capability to read it).
    //
    // PII (email) is deliberately NOT stored on this doc — it lives only in
    // Firebase Auth and, if ever surfaced again, under the owner-only /private
    // subcollection below. (Was previously gated by a logically-inverted
    // `exists(/crews/$(uid)) == false` predicate that evaluated true for nearly
    // every read — a meaningless guard. See docs/reviews/2026-06-13-aaa-architecture-review.md §5.13.)
    //
    // Hardening backlog: scope reads to crew-mates via a `crewIds` reverse index
    // + `hasAny()` (requires maintaining the index atomically on join/leave).
    match /accounts/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Owner-only private data (PII, consent, anything that must never be
      // crew-visible). Reads are denied to everyone but the owner.
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /devices/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Unlocked-achievement timestamps (badges design §16). One doc per unlocked
      // achievement (`accounts/{uid}/achievements/{achievementId}` = `{ unlockedAtEpochMs }`);
      // absence = locked. Owner-only on BOTH read and write — stricter than the
      // accounts/{uid} doc itself: achievements are private to the owner (like
      // /private and /devices), not crew-visible. Earning is client-derived, so the
      // owner legitimately writes these.
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Server-only nudge dedupe markers (`nudges/{dayKey}`) written by the
      // `streakNudge` Cloud Function via the Admin SDK (which bypasses rules).
      // Never read or written by clients — deny all client access explicitly so a
      // future broad rule can't accidentally expose this internal bookkeeping.
      match /nudges/{dayKey} {
        allow read, write: if false;
      }
    }

    // Crew root
    match /crews/{crewId} {
      // Read is open to any authenticated user. `crewId` is a random UUID, so it
      // functions as a soft access token — you need it to read the doc, and a
      // joining user must be able to read the doc inside the joinByCode transaction
      // before writing themselves into memberIds. Consistent with /crewCodes/ which
      // is already readable by any authenticated user.
      allow read:   if request.auth != null;
      // Update is partitioned into five explicit branches so non-owners can't rename
      // the crew and rogue clients can't rewrite ownerId / createdAt / code:
      //   (1) owner renames `name`
      //   (2) any current member renames themselves inside the `members` map
      //   (3) join — non-member adds self (auth.uid moves from absent to present in memberIds)
      //   (4) leave — existing member removes self (and only self) from memberIds + members
      //   (5) owner toggles the `blindVoting` policy flag (owner-only; no other field touched)
      //   (6) remove-member — owner removes another member (never self) from memberIds + members
      allow update: if request.auth != null
                    && (
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && resource.data.ownerId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blindVoting'])
                       && request.resource.data.blindVoting is bool)
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
                      ||
                      (!(request.auth.uid in resource.data.memberIds)
                       && request.auth.uid in request.resource.data.memberIds
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                       && request.resource.data.memberIds.size() <= 8)
                      ||
                      (request.auth.uid in resource.data.memberIds
                       && !(request.auth.uid in request.resource.data.memberIds)
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
                      ||
                      // (6) owner removes ANOTHER member: owner stays a member, the removed uid is
                      // dropped from both memberIds + members, and the set shrinks by exactly one.
                      // The owner can't remove self through this branch (they remain in both the old
                      // and new memberIds). ownerId/createdAt/code/name are untouched (hasOnly).
                      (resource.data.ownerId == request.auth.uid
                       && request.auth.uid in request.resource.data.memberIds
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
                       && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1)
                    );
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;
      // Delete is allowed when either the last member leaves OR the owner explicitly deletes.
      allow delete: if request.auth != null
                    && (
                      (request.auth.uid in resource.data.memberIds && resource.data.memberIds.size() == 1)
                      || resource.data.ownerId == request.auth.uid
                    );

      // Meals are scoped under crews. Up to 3 per author per day — one per slot.
      // Deterministic doc ID enforces same-day-per-slot uniqueness without composite indexes.
      match /meals/{mealId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                      && request.resource.data.slot in ["breakfast", "lunch", "dinner"]
                      && mealId == crewId + "_" + request.auth.uid + "_" + request.resource.data.dayKey + "_" + request.resource.data.slot
                      && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId))
                      // Whitelist the client-writable fields at publish. The server-owned fields
                      // `thumbHash` / `thumbnailPath` are written later by the image pipeline via
                      // the Admin SDK (which bypasses rules); a client must not be able to forge the
                      // blur placeholder or spoof a thumbnail URL at create. They are LISTED here —
                      // because GitLive's `.set(dto)` serializes with `encodeDefaults = true`, so it
                      // sends EVERY MealDto field, including these two as `null` — but pinned to
                      // `null` by the two clauses below so a client can only ever send them empty.
                      // `keys()` (not `diff().affectedKeys()`) because every field is new on create;
                      // hasOnly permits any of these to be absent (defaulted). Mirrors MealDto.
                      && request.resource.data.keys().hasOnly([
                        'id', 'authorId', 'authorName', 'crewId', 'dayKey', 'slot', 'platePath',
                        'dishName', 'description', 'latitude', 'longitude', 'publishedAtEpochMs',
                        'ratings', 'ratingSum', 'voterCount', 'ingredients', 'classifierVersion',
                        'cuisine', 'kind', 'thumbHash', 'thumbnailPath'
                      ])
                      // Server-owned: a client may only send these as null (or omit them).
                      && (!('thumbHash' in request.resource.data) || request.resource.data.thumbHash == null)
                      && (!('thumbnailPath' in request.resource.data) || request.resource.data.thumbnailPath == null)
                      // A meal MUST be created with zero rating aggregates. Without this
                      // the author could publish with ratingSum:9999 / voterCount:9 and win
                      // the server-attested weekly Best Cook / Best Meal digest. The vote
                      // path (update rule below) is the only way these may grow, recomputed
                      // from the `ratings` map. Tolerate absent fields (kotlinx-serialization
                      // may omit defaults on the create write).
                      && (!('ratingSum' in request.resource.data) || request.resource.data.ratingSum == 0)
                      && (!('voterCount' in request.resource.data) || request.resource.data.voterCount == 0)
                      && (!('ratings' in request.resource.data) || request.resource.data.ratings.size() == 0)
                      // No back/forward-dating into a different digest window.
                      && (!('publishedAtEpochMs' in request.resource.data)
                          || request.resource.data.publishedAtEpochMs <= request.time.toMillis() + 300000);
        // Rating-write update: a voter (not the author) may add their own entry to the
        // `ratings` map. The diff must be limited to the three denormalized rating fields,
        // the voter can only touch their own key in the map, and the cached sum/count
        // must equal the recomputed values from the new map.
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                      && request.auth.uid != resource.data.authorId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['ratings', 'ratingSum', 'voterCount'])
                      && request.resource.data.ratings.diff(resource.data.ratings).affectedKeys()
                           .hasOnly([request.auth.uid])
                      && !(request.auth.uid in resource.data.ratings)
                      && request.resource.data.ratings[request.auth.uid].score is int
                      && request.resource.data.ratings[request.auth.uid].score >= 1
                      && request.resource.data.ratings[request.auth.uid].score <= 5
                      && request.resource.data.voterCount == request.resource.data.ratings.size()
                      && request.time.toMillis() - resource.data.publishedAtEpochMs < 172800000;

        // Delete: the meal's author OR the crew owner may delete it. Author = self-service,
        // owner = moderation. Orphaned subcollections (comments, deprecated ratings) are
        // swept by the onMealDeleted Cloud Function since Firestore deletes don't cascade.
        allow delete: if request.auth != null
                      && (
                        request.auth.uid == resource.data.authorId
                        || request.auth.uid == get(/databases/$(database)/documents/crews/$(crewId)).data.ownerId
                      );

        // DEPRECATED 2026-05-20 — superseded by the denormalized `ratings` map on the
        // meal document itself. New clients never write to this subcollection. The
        // rule is kept for one release so any stragglers fail visibly rather than
        // silently. Remove in a follow-up cleanup.
        match /ratings/{raterUid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          allow create: if request.auth != null
                        && raterUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.auth.uid != get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.authorId
                        && !exists(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)/ratings/$(raterUid))
                        && request.resource.data.score is int
                        && request.resource.data.score >= 1
                        && request.resource.data.score <= 5
                        && request.resource.data.ratedAtEpochMs is int
                        && request.time.toMillis() - get(/databases/$(database)/documents/crews/$(crewId)/meals/$(mealId)).data.publishedAtEpochMs < 172800000;
        }

        match /comments/{commentId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          allow create: if request.auth != null
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.auth.uid == request.resource.data.authorId
                        && request.resource.data.text is string
                        && request.resource.data.text.size() >= 1
                        && request.resource.data.text.size() <= 500
                        && request.resource.data.createdAtEpochMs is int
                        && request.resource.data.createdAtEpochMs <= request.time.toMillis() + 60000
                        && request.resource.data.createdAtEpochMs >= request.time.toMillis() - 60000;

          // No update — comments are immutable once posted.
          // Delete: the comment's author OR the crew owner may delete it (self-service
          // + moderation), mirroring the meal delete rule above.
          allow delete: if request.auth != null
                        && (
                          request.auth.uid == resource.data.authorId
                          || request.auth.uid == get(/databases/$(database)/documents/crews/$(crewId)).data.ownerId
                        );
        }

        // Lightweight reactions (roadmap §1.3). One doc per member — the doc ID IS the
        // reactor uid, so a member can only ever touch their own reaction. The toggle
        // (add/remove) is a create-or-delete of `reactions/{uid}`; a re-react deletes,
        // a different kind overwrites via set (hence `update` is allowed for the owner of
        // the doc). Reads are open to any crew member. No push is sent on react.
        match /reactions/{reactorUid} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;

          // Create OR overwrite-set the member's own reaction. `kind` is a stable snake_case
          // discriminator string (the glyph is derived client-side, never stored).
          allow create, update: if request.auth != null
                        && reactorUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds
                        && request.resource.data.reactorId == request.auth.uid
                        && request.resource.data.kind is string
                        && request.resource.data.kind.size() >= 1
                        && request.resource.data.kind.size() <= 40
                        && request.resource.data.reactedAtEpochMs is int
                        && request.resource.data.reactedAtEpochMs <= request.time.toMillis() + 60000
                        && request.resource.data.reactedAtEpochMs >= request.time.toMillis() - 60000;

          // Delete only your own reaction (the toggle-off path). Same crew-membership
          // invariant as read/create/update — a removed member can't mutate crew data.
          allow delete: if request.auth != null
                        && reactorUid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        }
      }
    }

    // Ingredient catalog + dish→ingredients map — public, immutable reference data.
    // Read is open (`if true`) by design: the catalog is non-sensitive food vocabulary
    // and may be fetched before auth. Clients never write — both collections are seeded
    // and maintained only via the admin SDK (`functions/scripts/seed-catalog.ts`), which
    // bypasses Security Rules. (meal-AI design §263-264)
    match /ingredients/{slug} {
      allow read:  if true;
      allow write: if false;
    }
    match /dishIngredientMap/{dishSlug} {
      allow read:  if true;
      allow write: if false;
    }

    // Cuisine catalog + dish→cuisine map (cuisine passport) — public, immutable
    // reference data, same contract as the ingredient catalog above. Seeded only
    // via the admin SDK (`functions/scripts/seed-catalog.ts`); clients never write.
    // (feature roadmap §2.2)
    match /cuisines/{slug} {
      allow read:  if true;
      allow write: if false;
    }
    match /dishCuisineMap/{dishSlug} {
      allow read:  if true;
      allow write: if false;
    }

    // Invite codes — doc ID is the code; existence = uniqueness
    match /crewCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/crewCodes/$(code));
      allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/crews/$(resource.data.crewId)).data.memberIds;
    }
  }
}
