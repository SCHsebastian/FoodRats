rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Identity / account profiles
    match /accounts/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid ||
                      // any crew you're in can read your profile
                      exists(/databases/$(database)/documents/crews/$(uid)) == false);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /devices/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Crew root
    match /crews/{crewId} {
      allow read:   if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && request.resource.data.memberIds.size() <= 8;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.memberIds
                    && resource.data.memberIds.size() == 1;

      // Meals are scoped under crews
      match /meals/{mealId} {
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId
                      && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
        // No update path for MVP — meals are immutable once published.
      }
    }

    // Invite codes — doc ID is the code; existence = uniqueness
    match /crewCodes/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/crewCodes/$(code));
      allow delete: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/crews/$(resource.data.crewId)).data.memberIds;
    }
  }
}
