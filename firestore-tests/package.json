{
  "name": "foodrats-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security-rules unit tests for firestore.rules, run against the Firebase emulator.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-foodrats 'vitest run'",
    "test:watch": "firebase emulators:exec --only firestore,storage --project demo-foodrats 'vitest'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "firebase-tools": "^15.20.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "protobufjs", "re2", "@firebase/util"]
  }
}
