-- Migration v4 -> v5 (gallery meal photos: plate provenance). Adds the nullable `plateSource`
-- column to `meal` so the local feed cache round-trips the camera/gallery marker (mirrors
-- MealDto.plateSource). An EXISTING (v4) install gets the column added as NULL — every row synced
-- before the marker existed reads back as camera, exactly like a legacy Firestore doc; a fresh
-- install runs Schema.create() at v5 and gets it from Meal.sq directly. Keep byte-consistent with
-- Meal.sq's meal CREATE TABLE.
--
-- (verifyMigrations is off pre-launch — see core/database/build.gradle.kts — so there is no
-- committed schema dump to cross-check; this file exists so an upgraded dev/CI install isn't left
-- querying a column that doesn't exist, mirroring the 1.sqm / 2.sqm / 3.sqm rationale.)

ALTER TABLE meal ADD COLUMN plateSource TEXT;
