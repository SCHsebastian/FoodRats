-- Migration v3 -> v4 (vote-change feature). Adds the `edited` flag column to `mealRating` so a
-- rater's single allowed vote change can be tracked locally (mirrors RatingEntryDto.edited). An
-- EXISTING (v3) install gets the column added with 0 (no prior rating has been edited); a fresh
-- install runs Schema.create() at v4 and gets it from Meal.sq directly. Keep byte-consistent with
-- Meal.sq's mealRating CREATE TABLE.
--
-- (verifyMigrations is off pre-launch — see core/database/build.gradle.kts — so there is no
-- committed schema dump to cross-check; this file exists so an upgraded dev/CI install isn't left
-- querying a column that doesn't exist, mirroring the 1.sqm / 2.sqm rationale.)

ALTER TABLE mealRating ADD COLUMN edited INTEGER NOT NULL DEFAULT 0;
