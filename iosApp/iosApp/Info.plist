<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The app uses only standard/exempt cryptography (HTTPS/TLS). Declaring this skips the
	     manual export-compliance question on every TestFlight / App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Privacy / consent defaults: GA4 starts with collection OFF until the user grants consent
	     (IosAnalyticsTracker.applyConsent → setAnalyticsCollectionEnabled(true) via the bridge).
	     Screen views are tracked manually (NavGraph.TrackScreenViews), so disable the SDK's
	     automatic screen reporting to avoid double-counting. (human.md §D) -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>FoodRats uses the camera to capture your daily meal.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FoodRats can import meal photos from your library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FoodRats can tag your meal with where you ate it.</string>
	<key>GIDClientID</key>
	<string>475840003160-2grnq2fqeplj74b81rqrddk5p9f46dts.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GoogleSignIn</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.475840003160-2grnq2fqeplj74b81rqrddk5p9f46dts</string>
			</array>
		</dict>
		<!-- Custom-scheme deep links: foodrats://app/... (fallback for Universal Links). Universal
		     Links (https://foodrats.app/...) additionally need the Associated Domains entitlement +
		     a hosted apple-app-site-association — see deeplinks/README.md. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>es.schsebastian.foodrats.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>foodrats</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Lets the shareable story-card flow query Instagram before opening it
	  (instagram-stories://share). Without this, canOpenURL always returns false
	  and every share falls back to the system sheet. (Shareable story cards, spec §6.2.)
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<!--
	  Tells iOS the app supports English and Spanish. Required for the
	  "Preferred Language" section to appear in Settings → FoodRats. The
	  actual string resolution still flows through Compose Resources (which
	  reads NSLocale.preferredLanguages), so when the user picks a language
	  in iOS Settings the app re-launches with that locale applied.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>
