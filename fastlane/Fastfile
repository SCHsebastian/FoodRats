# FoodRats release automation.
#
# Android lanes assume Gradle has already produced a signed AAB (the CI job
# runs `:androidApp:bundleRelease` before invoking fastlane) — these lanes only
# upload. iOS lanes build with `gym` (which triggers the KMP framework Gradle
# task) and upload. Versioning is injected by the workflow via VERSION_NAME /
# VERSION_CODE env vars (see scripts/ci/compute_version.sh).
#
# Required env per platform is documented in docs/cicd-runbook.md.

# App Store Connect numeric app Apple ID (NOT the bundle id — that's es.schsebastian.foodrats).
# Passed to the iOS upload lanes so App-Store-Connect-API-key auth resolves the app directly
# instead of looking it up by bundle id. Public (it's the id in the App Store URL), not a secret.
ASC_APP_ID = "6781682875".freeze

default_platform(:android)

# ---------------------------------------------------------------------------
# Android → Google Play
# ---------------------------------------------------------------------------
platform :android do
  desc "Upload the signed AAB to the Play 'internal' testing track"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
  end

  desc "Upload the signed AAB to 'production' with a staged 20% rollout"
  lane :release do
    upload_to_play_store(
      track: "production",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "0.2",
    )
  end

  def aab_path
    ENV.fetch(
      "AAB_PATH",
      "androidApp/build/outputs/bundle/release/androidApp-release.aab",
    )
  end
end

# ---------------------------------------------------------------------------
# iOS → App Store Connect (TestFlight + App Store). Runs on the self-hosted Mac.
# ---------------------------------------------------------------------------
platform :ios do
  before_all do
    # On CI, create an ephemeral keychain so match can import the cert without
    # polluting (or being blocked by) the machine's login keychain.
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      apple_id: ASC_APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and submit to the App Store with phased release"
  lane :release do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      apple_id: ASC_APP_ID,
      submit_for_review: true,
      phased_release: true,
      precheck_include_in_app_purchases: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
    )
  end

  desc "Regenerate the App Store signing assets (distribution cert + provisioning profile) and " \
       "push them to the private match repo. Run this from a developer machine whenever the App " \
       "ID's capabilities change (e.g. after enabling Sign in with Apple) so the distribution " \
       "profile is re-issued with the new entitlements. The beta/release lanes consume these " \
       "read-only.\n\n" \
       "Non-interactive: authenticates to App Store Connect with the ASC API key (no Apple ID / " \
       "2FA prompt). Unlike the readonly Matchfile default, this lane writes (readonly: false, " \
       "force: true).\n\n" \
       "Required env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (the .p8), MATCH_GIT_URL (private " \
       "certs repo), MATCH_PASSWORD (repo encryption passphrase). See docs/cicd-runbook.md."
  lane :rotate_signing do
    asc_api_key
    sync_code_signing(
      type: "appstore",
      app_identifier: "es.schsebastian.foodrats",
      readonly: false,
      force: true,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
    )
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false,
    )
  end

  def build_ios
    profile = "match AppStore es.schsebastian.foodrats"
    # Scope manual signing to the app target ONLY. Passing CODE_SIGN_IDENTITY /
    # PROVISIONING_PROFILE_SPECIFIER as global xcargs leaks them onto the Swift
    # Package Manager dependency targets (leveldb, AppAuth, GoogleUtilities,
    # GoogleSignIn, …) which "do not support provisioning profiles" and fail the
    # archive (exit 65). update_code_signing_settings writes the signing config
    # into the app target only; the SPM targets keep their default (no profile).
    # App target: full manual signing with the App Store provisioning profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "iosApp/iosApp.xcodeproj",
      targets: ["iosApp"],
      team_id: "2AH7L26L78",
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: "es.schsebastian.foodrats",
    )
    # Embedded MealAiVision dynamic framework: distribution IDENTITY only. A framework
    # takes no provisioning profile (so no profile_name here). Without an explicit
    # identity it archives unsigned and the app's embed step rejects it
    # ("MealAiVision isn't code signed but requires entitlements"). Scoping this to the
    # framework target — instead of a global CODE_SIGN_IDENTITY xcarg — keeps the
    # identity off the SPM resource bundles (nanopb_nanopb.bundle,
    # GoogleUtilities_*-Reachability.bundle), which otherwise fail codesign with
    # errSecInternalComponent.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "iosApp/iosApp.xcodeproj",
      targets: ["MealAiVision"],
      team_id: "2AH7L26L78",
      code_sign_identity: "Apple Distribution",
    )
    build_app(
      workspace: "iosApp/iosApp.xcworkspace",
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: "build/ios",
      xcargs: [
        # Version only. NO global signing xcargs: a global CODE_SIGN_IDENTITY /
        # PROVISIONING_PROFILE_SPECIFIER leaks onto the SPM packages and their resource
        # bundles, which reject profiles / fail to sign. Signing is set per user-project
        # target by the two update_code_signing_settings calls above.
        "MARKETING_VERSION=#{ENV.fetch('VERSION_NAME')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('VERSION_CODE')}",
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          "es.schsebastian.foodrats" => profile,
        },
      },
    )
  end
end
