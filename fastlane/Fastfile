# FoodRats release automation.
#
# Android lanes assume Gradle has already produced a signed AAB (the CI job
# runs `:androidApp:bundleRelease` before invoking fastlane) — these lanes only
# upload. iOS lanes build with `gym` (which triggers the KMP framework Gradle
# task) and upload. Versioning is injected by the workflow via VERSION_NAME /
# VERSION_CODE env vars (see scripts/ci/compute_version.sh).
#
# Required env per platform is documented in docs/cicd-runbook.md.

default_platform(:android)

# ---------------------------------------------------------------------------
# Android → Google Play
# ---------------------------------------------------------------------------
platform :android do
  desc "Upload the signed AAB to the Play 'internal' testing track"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
  end

  desc "Upload the signed AAB to 'production' with a staged 20% rollout"
  lane :release do
    upload_to_play_store(
      track: "production",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      rollout: "0.2",
    )
  end

  def aab_path
    ENV.fetch(
      "AAB_PATH",
      "androidApp/build/outputs/bundle/release/androidApp-release.aab",
    )
  end
end

# ---------------------------------------------------------------------------
# iOS → App Store Connect (TestFlight + App Store). Runs on the self-hosted Mac.
# ---------------------------------------------------------------------------
platform :ios do
  before_all do
    # On CI, create an ephemeral keychain so match can import the cert without
    # polluting (or being blocked by) the machine's login keychain.
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and submit to the App Store with phased release"
  lane :release do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      submit_for_review: true,
      phased_release: true,
      precheck_include_in_app_purchases: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
    )
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false,
    )
  end

  def build_ios
    profile = "match AppStore es.schsebastian.foodrats"
    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: "build/ios",
      xcargs: [
        "MARKETING_VERSION=#{ENV.fetch('VERSION_NAME')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('VERSION_CODE')}",
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=2AH7L26L78",
        "CODE_SIGN_IDENTITY=Apple\\ Distribution",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile.gsub(' ', '\\ ')}",
      ].join(" "),
      export_options: {
        provisioningProfiles: {
          "es.schsebastian.foodrats" => profile,
        },
      },
    )
  end
end
