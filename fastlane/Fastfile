# FoodRats release automation.
#
# Android lanes assume Gradle has already produced a signed AAB (the CI job
# runs `:androidApp:bundleRelease` before invoking fastlane) — these lanes only
# upload. iOS lanes build with `gym` (which triggers the KMP framework Gradle
# task) and upload. Versioning is injected by the workflow via VERSION_NAME /
# VERSION_CODE env vars (see scripts/ci/compute_version.sh).
#
# Required env per platform is documented in docs/cicd-runbook.md.

# App Store Connect numeric app Apple ID (NOT the bundle id — that's es.schsebastian.foodrats).
# Passed to the iOS upload lanes so App-Store-Connect-API-key auth resolves the app directly
# instead of looking it up by bundle id. Public (it's the id in the App Store URL), not a secret.
ASC_APP_ID = "6781682875".freeze

# Drives the Crashlytics dSYM upload (it reads the Google App ID / API key from here).
GSP_PATH = "iosApp/iosApp/GoogleService-Info.plist".freeze

IOS_BUNDLE_ID = "es.schsebastian.foodrats".freeze

# Dedicated keychain for CI code signing (see platform :ios before_all). The
# password is local-only and NOT a secret — the signing assets themselves are
# protected by the match repo's MATCH_PASSWORD encryption.
KEYCHAIN_NAME = "fastlane_tmp_keychain".freeze
KEYCHAIN_PASSWORD = "fastlane".freeze

default_platform(:android)

# ---------------------------------------------------------------------------
# Android → Google Play
# ---------------------------------------------------------------------------
platform :android do
  desc "Upload the signed AAB to the Play 'internal' testing track"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
  end

  desc "Upload the signed AAB to 'production' with a staged 20% rollout"
  lane :release do
    # First-ever production release bootstrap: a never-published (draft) Play
    # app rejects staged rollouts too — "Invalid request - Precondition check
    # failed." on `Updating track 'production'` (the v1.11.0 prod fail; there
    # are no existing users to stage across). For the bootstrap release set
    # PLAY_RELEASE_STATUS=draft in the runner's signing.env: the AAB lands on
    # the production track as a DRAFT that the Play Console then publishes
    # (Google's first-publish review is console-only anyway). Remove the
    # override once the app is published so tagged releases resume the 20%
    # staged rollout.
    status = ENV.fetch("PLAY_RELEASE_STATUS", "inProgress")
    args = {
      track: "production",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # A staged rollout MUST be `inProgress`. Without this, supply defaults
      # release_status to "completed" and sends completed + userFraction 0.2 —
      # a contradiction (completed = 100%) that the Play API rejects with
      # "Invalid request - Precondition check failed." (the v1.10.3 prod fail).
      release_status: status,
    }
    args[:rollout] = "0.2" if status == "inProgress"
    upload_to_play_store(**args)
  end

  def aab_path
    ENV.fetch(
      "AAB_PATH",
      "androidApp/build/outputs/bundle/release/androidApp-release.aab",
    )
  end
end

# ---------------------------------------------------------------------------
# iOS → App Store Connect (TestFlight + App Store). Runs on the self-hosted Mac.
# ---------------------------------------------------------------------------
platform :ios do
  before_all do
    # On CI, import signing assets into a dedicated keychain.
    #
    # We deliberately do NOT call fastlane's `setup_ci` here. setup_ci is built
    # for *ephemeral* CI hosts: it makes the temp keychain the session DEFAULT
    # with a 1h auto-lock plus lock-on-sleep and never restores it. On our
    # *persistent* self-hosted Mac that produced the recurring "security wants
    # to use the fastlane_tmp_keychain-db keychain" prompt: every GUI app got
    # redirected to the locked temp default forever.
    #
    # The keychain DOES have to be the session default while the lane runs,
    # though: the v1.11.0 beta failed twice with errSecInternalComponent at
    # CodeSign even with the identity imported + partition-listed in a
    # non-default keychain and codesign pinned to it via --keychain — on this
    # runner codesign only signs headlessly through the DEFAULT keychain's key
    # ACL context (the exact configuration every green v1.10.x release used).
    # So: default for the lane's duration ONLY, with no auto-lock and no
    # lock-on-sleep (no prompts even mid-lane), and teardown_ci_keychain
    # restores the previous default on success AND error. See
    # docs/cicd-runbook.md.
    setup_signing_keychain if ENV["CI"]
  end

  after_all do |_lane|
    teardown_ci_keychain
  end

  error do |_lane, _exception|
    teardown_ci_keychain
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_testflight(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      apple_id: ASC_APP_ID,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and submit to the App Store with phased release"
  lane :release do
    asc_api_key
    sync_code_signing
    build_ios
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      # `upload_to_app_store` (deliver) resolves the app from `app_identifier`
      # (set in the Appfile) + the API key; it does NOT accept `apple_id` in
      # fastlane 2.230.x (only `upload_to_testflight`/pilot does — that's why
      # the beta lane works). Passing it errored: "Could not find option
      # 'apple_id' in the list of available options".
      app_identifier: "es.schsebastian.foodrats",
      # First-submission bootstrap: review submission requires a complete ASC
      # listing (pricing, age rating, screenshots incl. iPad Pro 12.9,
      # copyright) that only the console can seed — the v1.11.0 submission
      # failed on exactly those attributes AFTER the binary had uploaded and
      # been selected for the version. IOS_SUBMIT_FOR_REVIEW=false (runner
      # signing.env) keeps the upload + build selection but skips the review
      # submission — finish it in App Store Connect. Remove after the first
      # published release.
      submit_for_review: ENV.fetch("IOS_SUBMIT_FOR_REVIEW", "true") == "true",
      phased_release: true,
      precheck_include_in_app_purchases: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
    )
  end

  desc "Regenerate the App Store signing assets (distribution cert + provisioning profile) and " \
       "push them to the private match repo. Run this from a developer machine whenever the App " \
       "ID's capabilities change (e.g. after enabling Sign in with Apple) so the distribution " \
       "profile is re-issued with the new entitlements. The beta/release lanes consume these " \
       "read-only.\n\n" \
       "Non-interactive: authenticates to App Store Connect with the ASC API key (no Apple ID / " \
       "2FA prompt). Unlike the readonly Matchfile default, this lane writes (readonly: false, " \
       "force: true).\n\n" \
       "Required env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (the .p8), MATCH_GIT_URL (private " \
       "certs repo), MATCH_PASSWORD (repo encryption passphrase). See docs/cicd-runbook.md."
  lane :rotate_signing do
    asc_api_key
    sync_code_signing(
      type: "appstore",
      app_identifier: IOS_BUNDLE_ID,
      readonly: false,
      force: true,
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
    )
  end

  desc "Clear a Crashlytics 'missing dSYM' warning for an already-shipped build by downloading " \
       "its dSYMs from App Store Connect and uploading them to Crashlytics. Defaults to the build " \
       "that reported the warning (1.10.2 / 10031); override with `version:` / `build_number:`, or " \
       "pass `latest:true` to grab the newest processed build.\n\n" \
       "Why this is needed: the in-archive Crashlytics `run` build phase does not reliably upload " \
       "dSYMs from a `gym` archive, so a shipped build can land on TestFlight/App Store without " \
       "its symbols. The beta/release lanes now upload dSYMs on every build (build_ios), so this " \
       "lane is only for retroactively fixing builds made before that wiring existed.\n\n" \
       "Example: bundle exec fastlane ios refresh_dsyms version:1.10.2 build_number:10031"
  lane :refresh_dsyms do |options|
    asc_api_key
    download_dsyms(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: IOS_BUNDLE_ID,
      version: options[:latest] ? nil : (options[:version] || "1.10.2"),
      build_number: options[:latest] ? nil : (options[:build_number] || "10031"),
      latest: options[:latest] || false,
    )
    paths = lane_context[SharedValues::DSYM_PATHS]
    if paths.nil? || paths.empty?
      UI.user_error!(
        "App Store Connect returned no dSYMs for the requested build. The build may still be " \
        "processing, or it was uploaded without symbols. Check the version/build_number.",
      )
    end
    upload_dsyms_to_crashlytics(dsym_paths: paths)
  end

  # Create the dedicated signing keychain used by match/gym on CI. Unlike
  # setup_ci it (a) does NOT become the session default — so GUI apps keep using
  # the login keychain and are never redirected here — and (b) has NO auto-lock
  # and NO lock-on-sleep, so a `security`/`codesign` call mid-build never finds
  # it locked and never prompts. Recreated fresh each run so an interrupted
  # prior run can't leave a stale/locked keychain behind.
  def setup_signing_keychain
    path = signing_keychain_db
    delete_keychain(name: KEYCHAIN_NAME) if File.exist?(path)
    # Remember the session's real default so teardown can restore it — leaving
    # the temp keychain as default forever was the June prompt bug.
    ENV["FR_PREV_DEFAULT_KEYCHAIN"] =
      `security default-keychain -d user`.strip.delete('"')
    create_keychain(
      name: KEYCHAIN_NAME,
      password: KEYCHAIN_PASSWORD,
      default_keychain: true,   # required: headless codesign resolves key ACLs
                                # through the default keychain (see before_all);
                                # teardown restores the previous default
      unlock: true,
      timeout: 0,               # 0 = never auto-lock (setup_ci uses 3600)
      lock_when_sleeps: false,  # do NOT lock on sleep
      add_to_search_list: true, # codesign/gym still find the identity via the search list
    )
    # Point match at this keychain (it would otherwise import into login.keychain).
    # match also sets the key partition list on import, so codesign signs
    # non-interactively without the separate "codesign wants to use key" prompt.
    ENV["MATCH_KEYCHAIN_NAME"] = KEYCHAIN_NAME
    ENV["MATCH_KEYCHAIN_PASSWORD"] = KEYCHAIN_PASSWORD
  end

  # Absolute path of the dedicated signing keychain's on-disk file.
  def signing_keychain_db
    File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")
  end

  # Re-assert the private-key partition list on the dedicated keychain AFTER
  # match has imported the signing key. match sets `apple-tool:,apple:` itself,
  # but this is cheap, idempotent, and version-proof — and it must run after
  # import (before_all runs too early, the key isn't there yet). CI-only: the
  # keychain doesn't exist on developer machines.
  def authorize_headless_codesign
    return unless ENV["CI"]

    # stdout silenced (it dumps key attributes); stderr kept so a failure of
    # this step is visible in the CI log instead of dying later at CodeSign.
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: " \
       "-s -k #{KEYCHAIN_PASSWORD.shellescape} #{signing_keychain_db.shellescape} " \
       ">/dev/null")
  end

  # Tear down the signing keychain created in before_all: restore the session's
  # previous default keychain, then delete the temp one (which also drops it
  # from the search list). Runs on both success (after_all) and failure (error).
  # No-op when not on CI.
  def teardown_ci_keychain
    return unless ENV["CI"]

    prev = ENV["FR_PREV_DEFAULT_KEYCHAIN"]
    if prev && !prev.empty?
      sh("security default-keychain -d user -s #{prev.shellescape}")
    end
    delete_keychain(name: KEYCHAIN_NAME)
  rescue StandardError => e
    UI.important("Keychain teardown skipped: #{e.message}")
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false,
    )
  end

  def build_ios
    profile = "match AppStore es.schsebastian.foodrats"
    # Scope manual signing to the app target ONLY. Passing CODE_SIGN_IDENTITY /
    # PROVISIONING_PROFILE_SPECIFIER as global xcargs leaks them onto the Swift
    # Package Manager dependency targets (leveldb, AppAuth, GoogleUtilities,
    # GoogleSignIn, …) which "do not support provisioning profiles" and fail the
    # archive (exit 65). update_code_signing_settings writes the signing config
    # into the app target only; the SPM targets keep their default (no profile).
    # App target: full manual signing with the App Store provisioning profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "iosApp/iosApp.xcodeproj",
      targets: ["iosApp"],
      team_id: "2AH7L26L78",
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: "es.schsebastian.foodrats",
    )
    # Embedded MealAiVision dynamic framework: distribution IDENTITY only. A framework
    # takes no provisioning profile (so no profile_name here). Without an explicit
    # identity it archives unsigned and the app's embed step rejects it
    # ("MealAiVision isn't code signed but requires entitlements"). Scoping this to the
    # framework target — instead of a global CODE_SIGN_IDENTITY xcarg — keeps the
    # identity off the SPM resource bundles (nanopb_nanopb.bundle,
    # GoogleUtilities_*-Reachability.bundle), which otherwise fail codesign with
    # errSecInternalComponent.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "iosApp/iosApp.xcodeproj",
      targets: ["MealAiVision"],
      team_id: "2AH7L26L78",
      code_sign_identity: "Apple Distribution",
    )
    authorize_headless_codesign
    xcargs = [
      # Version only. NO global signing xcargs: a global CODE_SIGN_IDENTITY /
      # PROVISIONING_PROFILE_SPECIFIER leaks onto the SPM packages and their resource
      # bundles, which reject profiles / fail to sign. Signing is set per user-project
      # target by the two update_code_signing_settings calls above.
      "MARKETING_VERSION=#{ENV.fetch('VERSION_NAME')}",
      "CURRENT_PROJECT_VERSION=#{ENV.fetch('VERSION_CODE')}",
    ]
    # Pin codesign's key lookup to the dedicated CI keychain. The persistent
    # runner's login keychain carries DUPLICATE "Apple Distribution" identities
    # whose private keys are prompt-guarded; without the pin codesign resolves
    # those (search-list order) and dies headless with errSecInternalComponent —
    # exactly how the v1.11.0 beta archive failed on MealAiVision (2026-07-13).
    # A keychain pin only scopes key LOOKUP, so ad-hoc-signed SPM bundles are
    # unaffected (unlike the global-identity leak documented above).
    xcargs << "OTHER_CODE_SIGN_FLAGS='--keychain #{signing_keychain_db}'" if ENV["CI"]
    build_app(
      workspace: "iosApp/iosApp.xcworkspace",
      scheme: "iosApp",
      export_method: "app-store",
      output_directory: "build/ios",
      xcargs: xcargs.join(" "),
      export_options: {
        provisioningProfiles: {
          IOS_BUNDLE_ID => profile,
        },
      },
    )
    # Upload the just-built dSYMs to Crashlytics. The in-archive Crashlytics `run`
    # build phase does not reliably emit symbols from a gym archive, so do it
    # explicitly here. Non-fatal: a symbol-upload hiccup must not abort a release
    # whose binary already built — the TestFlight/App Store upload still runs.
    upload_dsyms_to_crashlytics
  end

  # Upload dSYMs to Crashlytics via Firebase's upload-symbols tool. With no
  # dsym_paths, uploads the dSYM gym just produced (lane_context DSYM_OUTPUT_PATH).
  # Firebase is integrated via SPM, so the upload-symbols binary isn't at the
  # CocoaPods path fastlane probes by default — locate it in the SPM checkout.
  def upload_dsyms_to_crashlytics(dsym_paths: nil)
    paths = (dsym_paths || [lane_context[SharedValues::DSYM_OUTPUT_PATH]])
            .compact.uniq.select { |p| File.exist?(p) }
    if paths.empty?
      UI.important("No dSYMs found to upload to Crashlytics; skipping.")
      return
    end
    binary = crashlytics_upload_binary
    paths.each do |path|
      upload_symbols_to_crashlytics(
        dsym_path: path,
        gsp_path: GSP_PATH,
        binary_path: binary,
      )
    end
  rescue StandardError => e
    UI.important("Crashlytics dSYM upload failed (non-fatal): #{e.message}")
  end

  # Resolve Firebase's `upload-symbols` binary from the SPM checkout. gym's
  # DerivedData hash isn't stable, so glob both the default DerivedData location
  # and the in-repo build dirs and take the freshest hit.
  def crashlytics_upload_binary
    rel = "SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
    candidates =
      Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/iosApp-*/#{rel}")) +
      Dir.glob("iosApp/**/#{rel}")
    binary = candidates.select { |p| File.file?(p) }.max_by { |p| File.mtime(p) }
    unless binary
      UI.user_error!(
        "Crashlytics upload-symbols not found. Build the iOS app first so SPM resolves " \
        "firebase-ios-sdk, then re-run.",
      )
    end
    binary
  end
end
