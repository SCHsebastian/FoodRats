rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — one image per account, addressed by uid. Owner-only writes; any
    // signed-in user can read (avatars surface in crew member rows + feed cards
    // for everyone in the crew, so a single shared read policy is simplest).
    match /avatars/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && filename == request.auth.uid + ".jpg"
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpe?g');
      allow delete: if request.auth != null
                    && filename == request.auth.uid + ".jpg";
    }

    // Meal plate photos. Path is `crews/{crewId}/meals/{mealId}.jpg`, with
    // mealId = `<crewId>_<uid>_<dayKey>_<slot>` (see MealId.forDaySlot).
    // We enforce author identity by parsing the uid out of mealId so the rule
    // doesn't need to read Firestore. Membership in the crew is enforced
    // separately by the matching Firestore rule on the meal doc — without
    // that doc the photo is orphaned and unreferenced.
    match /crews/{crewId}/meals/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && filename.matches(crewId + '_' + request.auth.uid + '_.*\\.jpg')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpe?g');
    }

    // Default: deny.
  }
}
