rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars — one folder per account, keyed by uid. The object name within is content-versioned
    // (`avatars/{uid}/{token}.jpg`) so a re-upload changes the path and the change surfaces live
    // (the old fixed `avatars/{uid}.jpg` stayed stale until an app restart). Owner-only writes:
    // the uid is its own path segment, so we match it directly instead of parsing a filename.
    //
    // Direct reads are DENIED (#15): a download-token URL bypasses these rules entirely
    // (anyone with the `?token=…` string can fetch). Clients no longer mint tokens — they
    // store the object path and read via short-lived, membership-checked V4 signed URLs
    // from the `mintPlateUrls` callable, which sign with the service account and so are not
    // subject to these read rules.
    match /avatars/{uid}/{filename} {
      allow read: if false;
      allow write: if request.auth != null
                   && uid == request.auth.uid
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpe?g');
      allow delete: if request.auth != null
                    && uid == request.auth.uid;
    }

    // Meal plate photos. Path is `crews/{crewId}/meals/{mealId}.jpg`, with
    // mealId = `<crewId>_<uid>_<dayKey>_<slot>` (see MealId.forDaySlot).
    // We enforce author identity by parsing the uid out of mealId so the rule
    // doesn't need to read Firestore.
    //
    // Direct reads are DENIED (#15) — same rationale as avatars above. The
    // `mintPlateUrls` callable verifies crew membership before signing a read URL, so a
    // non-member (or a logged-out holder of an old token URL) can no longer fetch a plate.
    //
    // Thumbnails (`<mealId>_thumb.jpg`) are written ONLY by the `onPlateImageFinalized`
    // Cloud Function via the Admin SDK (which bypasses these rules). The explicit
    // `_thumb.jpg` suffix exclusion below blocks any client from writing/overwriting a
    // thumbnail — a `<crewId>_<uid>_..._thumb.jpg` name would otherwise match the author
    // pattern and slip through.
    match /crews/{crewId}/meals/{filename} {
      allow read: if false;
      // The filename embeds the author uid (scopes the write to the caller's own plate), but the
      // crewId path segment was previously unconstrained — any authenticated user could litter
      // ≤5MB JPEGs into ANY crew's prefix (storage cost / orphan abuse; reads are denied so it's
      // not an exfil path). Gate the write on crew membership via a cross-service firestore.get,
      // mirroring the crew-banner rule below.
      allow write: if request.auth != null
                   && filename.matches(crewId + '_' + request.auth.uid + '_.*\\.jpg')
                   && !filename.matches('.*_thumb\\.jpg')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpe?g')
                   && request.auth.uid in
                        firestore.get(/databases/(default)/documents/crews/$(crewId)).data.memberIds;
      // Author-scoped delete. `allow write` nominally covers delete, but its size/contentType
      // clauses reference `request.resource`, which is NULL on a delete — so they can never be
      // satisfied and delete would always 403. This explicit rule lets the author reclaim their
      // OWN plate: best-effort orphan cleanup when a publish's Firestore write fails after the
      // upload succeeded (FirebaseMealRepository). Scoped exactly like `write` (the filename
      // embeds the author uid); thumbnails are server-owned (Admin SDK) and excluded.
      allow delete: if request.auth != null
                    && filename.matches(crewId + '_' + request.auth.uid + '_.*\\.jpg')
                    && !filename.matches('.*_thumb\\.jpg');
    }

    // Crew banner images (C9). Path: `crew_banners/{crewId}/banner.jpg` — one image per crew.
    // Only the crew OWNER may upload or delete. The banner object's path does NOT embed the
    // owner uid (unlike avatars/plates, which encode the uid in the filename), so we MUST read
    // the crew doc's `ownerId` cross-service to authorize the write/delete. The client-side
    // owner check in FirebaseCrewRepository is convenience only — this rule is the real gate.
    //
    // Direct reads are DENIED (same rationale as plate photos and avatars above): banner URLs
    // are short-lived V4 signed URLs minted by `mintPlateUrls` after a crew-membership check.
    match /crew_banners/{crewId}/{filename} {
      function isCrewOwner() {
        return request.auth != null
               && firestore.get(/databases/(default)/documents/crews/$(crewId)).data.ownerId == request.auth.uid;
      }
      allow read: if false;
      allow write: if isCrewOwner()
                   && filename == "banner.jpg"
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpe?g');
      allow delete: if isCrewOwner()
                    && filename == "banner.jpg";
    }

    // GDPR data-export archives (Art. 20). Written ONLY by the `exportMyData` callable via the
    // Admin SDK (which bypasses these rules), and the user downloads via the short-lived V4 signed
    // URL that callable mints (signed reads also bypass rules). The explicit owner-only read here
    // is defense-in-depth — a user may read only their OWN export object, and no client may write.
    match /exports/{uid}/{filename} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Default: deny.
  }
}
